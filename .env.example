MCP_HOST=127.0.0.1
MCP_PORT="8000"
MCP_ENV="local"
# Extra host names the server answers to, comma-separated, when hosted publicly under
# a name other than mcp.data.gouv.fr (DNS-rebinding protection). See docs/hosting.md.
# MCP_ALLOWED_HOSTS="mcp.example.pt"
DATAGOUV_API_ENV="prod"

# Other udata instance: setting UDATA_API_URL overrides DATAGOUV_API_ENV.
# Satellite services are only used when their URL is set. Without a Metrics API,
# get_metrics is not registered. Without a Tabular API, query_resource_data
# downloads CSV/TSV/XLSX files (up to LOCAL_QUERY_MAX_BYTES) and queries them locally.
# UDATA_API_URL="https://dados.gov.pt/api/"
# UDATA_SITE_URL="https://dados.gov.pt/"  # defaults to UDATA_API_URL without "api/"
# UDATA_PORTAL_NAME="dados.gov.pt"  # name used in tool descriptions, defaults to the site host
# UDATA_LANGUAGE="pt"  # fr | pt | en: search stop words and description examples (fr on data.gouv.fr, en otherwise)
# TABULAR_API_URL=""
# METRICS_API_URL=""
# CRAWLER_API_URL=""
# LOCAL_QUERY_MAX_BYTES="26214400"  # 25 MB by default; 0 disables the local fallback
# Files downloaded for local queries are kept on disk; past the total size, the least
# recently accessed ones are deleted. See docs/local-queries.md.
# LOCAL_QUERY_CACHE_DIR="~/.cache/datagouv-mcp/resources"
# LOCAL_QUERY_CACHE_MAX_BYTES="1073741824"  # 1 GB by default; 0 disables the on-disk cache
# LOCAL_QUERY_CACHE_REVALIDATE_SECONDS="86400"  # re-check a cached file with its source after 24 hours
# Local copy of the portal's catalog export (python -m helpers.catalog_mirror), see docs/catalog-mirror.md.
# UDATA_CATALOG_DATASET="67c5a3b3b50fe67ba7aa1905"  # dados.gov.pt
# UDATA_CATALOG_DIR="~/.local/share/datagouv-mcp/catalog/dados.gov.pt"
# Optional semantic search over the local copy, see docs/semantic-search.md.
# EMBEDDINGS_API_URL="http://127.0.0.1:8918/v1"  # OpenAI-compatible endpoint; unset disables it
# EMBEDDINGS_MODEL="bge-m3"
# UDATA_CATALOG_SEARCH="0"  # search_datasets uses the local copy when there is one; 0 forces the portal's API
LOG_LEVEL="INFO"

# SSRF: leave unset on the hosted server (no loopback / private / link-local).
# Set only for local tooling that must fetch specs on localhost or a private network.
# URLS_ALLOW_LOCAL="false"
# URLS_ALLOW_PRIVATE="false"

# Matomo tracking — set MATOMO_URL and MATOMO_SITE_ID to enable; leave both unset (or empty) to disable
# MATOMO_URL="https://matomo.example.org"
# MATOMO_SITE_ID="1"
# MATOMO_AUTH_TOKEN="1234567890"

# Sentry error and performance monitoring
# SENTRY_DSN="https://..."
# SENTRY_SAMPLE_RATE="1.0"
