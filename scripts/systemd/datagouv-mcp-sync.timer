[Unit]
Description=Sync the datagouv-mcp fork with upstream every Monday at 08:00

[Timer]
# Weekly is plenty: upstream releases roughly once a month. Persistent=true
# catches up after suspend/off, which is safe because a run with nothing new
# upstream (or with a sync PR already open) exits without doing anything.
OnCalendar=Mon *-*-* 08:00:00
Persistent=true
RandomizedDelaySec=15min
AccuracySec=5min

[Install]
WantedBy=timers.target
