MCP_HOST=127.0.0.1
MCP_PORT="8000"
MCP_ENV="local"
DATAGOUV_API_ENV="prod"

# Other udata instance: setting UDATA_API_URL overrides DATAGOUV_API_ENV.
# Satellite services are only used when their URL is set; tools that need a
# missing service (query_resource_data, get_metrics) are not registered.
# UDATA_API_URL="https://dados.gov.pt/api/"
# UDATA_SITE_URL="https://dados.gov.pt/"  # defaults to UDATA_API_URL without "api/"
# UDATA_PORTAL_NAME="dados.gov.pt"  # name used in tool descriptions, defaults to the site host
# UDATA_LANGUAGE="pt"  # fr | pt | en: search stop words and description examples (fr on data.gouv.fr, en otherwise)
# TABULAR_API_URL=""
# METRICS_API_URL=""
# CRAWLER_API_URL=""
LOG_LEVEL="INFO"

# SSRF: leave unset on the hosted server (no loopback / private / link-local).
# Set only for local tooling that must fetch specs on localhost or a private network.
# URLS_ALLOW_LOCAL="false"
# URLS_ALLOW_PRIVATE="false"

# Matomo tracking — set MATOMO_URL and MATOMO_SITE_ID to enable; leave both unset (or empty) to disable
# MATOMO_URL="https://matomo.example.org"
# MATOMO_SITE_ID="1"
# MATOMO_AUTH_TOKEN="1234567890"

# Sentry error and performance monitoring
# SENTRY_DSN="https://..."
# SENTRY_SAMPLE_RATE="1.0"
